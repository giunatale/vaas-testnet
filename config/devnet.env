# Parameter profile "devnet": the private devnet's parameter set. 5 s blocks,
# 120-block epochs (about 11 min), 2 h votes, spawn 30 min after registration
# so every validator brings its consumer nodes up first.
TIMEOUT_COMMIT=5s

# provider genesis
UNBONDING_TIME=259200s
KEY_ROTATION_FEE=1000000
VOTING_PERIOD=7200s
SLASHING_SIGNED_BLOCKS_WINDOW=10000
SLASHING_MIN_SIGNED_PER_WINDOW=0.050000000000000000
SLASHING_DOWNTIME_JAIL_DURATION=600s
BLOCKS_PER_EPOCH=120
VAAS_TIMEOUT_PERIOD=3600s
FEES_PER_BLOCK_AMOUNT=1000
MIN_DEPOSIT_BLOCKS=1440
LIVENESS_GRACE_FRACTION=0.500000000000000000
MAX_PAUSE_DURATION=259200s
EQUIVOCATION_EXECUTION_DELAY=86400s
REMOVAL_VOTE_DEFERRAL_MARGIN=600s
DOWNTIME_SLASH_FRACTION=0.000100000000000000
DOWNTIME_GRACE_PERIOD=7200s
DOWNTIME_SIGNED_BLOCKS_WINDOW=600
DOWNTIME_MIN_SIGNED_PER_WINDOW=0.500000000000000000
DOWNTIME_EVIDENCE_MAX_AGE=21600s
DOWNTIME_CHALLENGE_WINDOW=43200s

# consumer registration (seconds)
CONSUMER_UNBONDING_PERIOD=216000
CONSUMER_VAAS_TIMEOUT_PERIOD=3600
CONSUMER_SAFE_MODE_THRESHOLD=3600
CONSUMER_HISTORICAL_ENTRIES=10000
SPAWN_DELAY=1800

# funding
FEE_POOL_DEPOSIT=100000000
RELAYER_MAX_AGE=3600

# The forge consumer is for the localnet's drills only.
CONSUMERS="ref gno photon"
