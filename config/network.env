# The network: one AtomOne provider and four VAAS consumers, every chain run
# by the same NUM_VALIDATORS validators (a consumer's validator set is the
# provider's, delivered over VSC packets). The compose file defines four
# validators per chain; NUM_VALIDATORS must match it.
NUM_VALIDATORS=4

PROVIDER_CHAIN_ID=atomone-localnet
PROVIDER_DENOM=uatone
PROVIDER_FEE_DENOM=uphoton

# Consumers, in registration order (their consumer ids follow it).
CONSUMERS="ref gno photon forge"

# ref: the VAAS reference consumer, fees in its own denom.
REF_CHAIN_ID=vaas-ref-localnet
REF_BINARY=consumer
REF_DENOM=uref
REF_PREFIX=ref
REF_PREFIX_ENV=VAAS_BECH32_PREFIX
REF_PHOTON_FEES=false
REF_NAME="VAAS reference consumer"

# gno: gnoshard, the reference consumer with ignite/gnovm.
GNO_CHAIN_ID=gnoshard-localnet
GNO_BINARY=gnoshardd
GNO_DENOM=ushard
GNO_PREFIX=gnoshard
GNO_PREFIX_ENV=GNOSHARD_BECH32_PREFIX
GNO_PHOTON_FEES=false
GNO_NAME="gnoshard"

# photon: the reference consumer with photon fees: user fees only in the
# uphoton voucher bridged from AtomOne over the pinned provider client.
PHOTON_CHAIN_ID=vaas-photon-localnet
PHOTON_BINARY=consumer
PHOTON_DENOM=uref
PHOTON_PREFIX=photon
PHOTON_PREFIX_ENV=VAAS_BECH32_PREFIX
PHOTON_PHOTON_FEES=true
PHOTON_NAME="VAAS reference consumer with photon fees"

# forge: the reference consumer run by consumer-forge, which can be told to
# report one validator absent for a range of heights (data/forge/lie.env,
# written by `make forge-challenge`); honest otherwise. It exercises a
# forged downtime accusation and the challenge that answers it.
FORGE_CHAIN_ID=vaas-forge-localnet
FORGE_BINARY=consumer
FORGE_DENOM=uforge
FORGE_PREFIX=forge
FORGE_PREFIX_ENV=VAAS_BECH32_PREFIX
FORGE_PHOTON_FEES=false
FORGE_NAME="VAAS reference consumer run by consumer-forge"
