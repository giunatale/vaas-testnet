# Where each image is built from: a public git repository at a pinned commit
# (<X>_REPO, <X>_REF), the commit taken from the head of <X>_BRANCH by
# `make sources-bump`. Setting <X>_SRC to a local checkout builds from it
# instead (make images RELAYER_SRC=../ibc-v2-ts-relayer).
#
# AtomOne: the VAAS provider wiring on the integrated VAAS tree.
ATOMONE_REPO=https://github.com/giunatale/atomone.git
ATOMONE_BRANCH=vaas-pre-mvp
ATOMONE_REF=5b17783999be0c445fecce4da38d1f74c8e380e1
# VAAS: every open VAAS pull request merged.
VAAS_REPO=https://github.com/giunatale/vaas.git
VAAS_BRANCH=pre-mvp
VAAS_REF=e46f6226ae9998152963c592e6fdbabbf77f80ca
# ts-relayer: allinbits main.
RELAYER_REPO=https://github.com/allinbits/ibc-v2-ts-relayer.git
RELAYER_BRANCH=main
RELAYER_REF=a49e81414c4293d52f4a9848be7ea3ba18c94c98
# gnoshard: the VAAS reference consumer with ignite/gnovm.
GNOSHARD_REPO=https://github.com/giunatale/gnoshard.git
GNOSHARD_BRANCH=main
GNOSHARD_REF=c24a9f3e22bf4050b0bef4e4387e732f6ac2d3c5

# Image tags the compose file runs.
ATOMONE_IMAGE=vaas-testnet/atomone:local
CONSUMER_IMAGE=vaas-testnet/vaas-consumer:local
GNOSHARD_IMAGE=vaas-testnet/gnoshard:local
RELAYER_IMAGE=vaas-testnet/ts-relayer:local

# Lowest governance voting period the AtomOne binary accepts.
MIN_VOTING_PERIOD=60s
